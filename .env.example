# ---- 榜单数据源(Supabase) ----
# Supabase 控制台 → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 前端只读用 anon key(有 RLS 保护,只能 SELECT)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon
# 写入用 service_role key(只放服务端 / Vercel 环境变量,千万别加 NEXT_PUBLIC_ 前缀)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role

# ---- 抓取 ----
# Apify 控制台 → Settings → Integrations → API token
APIFY_TOKEN=apify_api_xxxxxxxx
# 换 actor 时记得同步改 lib/x-pipeline.mjs 里的 buildApifyInput()
APIFY_ACTOR_ID=apidojo/tweet-scraper
X_MAX_ITEMS=100
# 留空则自动用「过去 24 小时 + 简中 + 点赞 100+ + 排除回复」
X_SEARCH_QUERY=
# apify = 真抓;mock = 用假数据跑通链路(本地自测用)
INGEST_SOURCE=apify

# ---- 定时任务鉴权 ----
# openssl rand -hex 32
CRON_SECRET=
